{
  "name": "team01-the-async-actors",
  "version": "1.0.0",
  "description": "Playwright BDD automation framework for Suite8",
  "type": "module",
 

  "scripts": {
    "clean:reports": "rimraf allure-results allure-report playwright-report test-results tests/generated",

    "bddgen": "bddgen",

    "allure:environment": "node scripts/create-allure-environment.js",

    "test:all": "npm run clean:reports && npm run bddgen && npm run allure:environment && playwright test",

    "test:local": "cross-env TEST_ENV=local npm run test:all",
    "test:qa": "cross-env TEST_ENV=qa npm run test:all", 
    "test:prod": "cross-env TEST_ENV=prod npm run test:all",

    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results"
  },
  "keywords": [
    "playwright",
    "bdd",
    "automation",
    "suite8",
    "allure"
  ],
  "author": "Team01 The Async Actors",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.13.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.6",
    "playwright-bdd": "^9.2.1",
    "rimraf": "^6.1.3",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5"
  }
}
